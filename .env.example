# ==========================================
# Silent Meeting Intelligence — Configuration
# ==========================================
# Copy this file to .env and fill in your values

# --- Groq API Key (Required) ---
# Get a FREE key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- AssemblyAI API Key (Optional — for Speaker Diarization) ---
# Get a FREE key at: https://www.assemblyai.com (5 hours/month free)
# Leave blank to fall back to Groq Whisper (no speaker labels)
ASSEMBLYAI_API_KEY=

# --- LLM Settings (leave as is) ---
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- App Settings ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100

# --- Multi-Language Support ---
# Default transcription language. "auto" = Whisper detects automatically.
# Supported codes: en, hi, ta, te, kn, ml, fr, de, es, ja, zh, ar, pt, ru
DEFAULT_LANGUAGE=auto

# --- Database ---
# Option 1: SQLite (default, no setup needed — just leave this blank)
DB_PATH=meetings.db
DATABASE_URL=

# Option 2: PostgreSQL (uncomment and fill in for production deployment)
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/meetings_db

# --- JWT Authentication ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Legacy API Key (for Streamlit dashboard backward compatibility) ---
API_KEY=silent-meeting-super-secret-2025

# ─────────────────────────────────────────────
# Platform Integrations
# ─────────────────────────────────────────────

# --- Zoom Integration ---
# Create a Server-to-Server OAuth app at: https://marketplace.zoom.us/develop/create
# Required scope: cloud_recording:read:list_account_recordings
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Google Meet Integration ---
# Meet recordings are saved to Google Drive.
# Create a Service Account at: https://console.cloud.google.com
# Enable "Google Drive API" and share your Drive folder with the service account email.
# Set to the raw JSON string of the service account key OR path to the key file.
GOOGLE_SERVICE_ACCOUNT_INFO=

# --- Microsoft Teams Integration ---
# Create an App Registration at: https://portal.azure.com
# Required Graph permissions: CallRecords.Read.All, Files.Read.All, OnlineMeetings.Read.All
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
